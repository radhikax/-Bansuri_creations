# Copy to .env.web (never commit it) and fill in real values.
# Read only by the web service in docker-compose.prod.yml. Keep API secrets
# (database, JWT, Razorpay, email) out of this file: they live in .env.api.

# --- Web ---
# Public URL the shop is served from. SITE_URL is read at runtime (not baked
# into the image), so setting it here is enough — no build arg needed, and it
# can be changed without rebuilding. Used for canonical/OG URLs, JSON-LD and
# robots.txt/sitemap.xml.
SITE_URL=https://shop.example.com
# Build-time fallback only, for a checkout that still sets it; SITE_URL above
# always wins at runtime when both are set. Baked into the client bundle at
# `docker compose build` time if you build locally instead of pulling the
# published image.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# The same value as REVALIDATE_SECRET in .env.api: the web container rejects
# POST /internal/revalidate unless the API's x-revalidate-secret header matches.
REVALIDATE_SECRET=
