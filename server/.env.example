PORT=4000
# Optional: instant page refresh. After an admin edit or a sale the API asks the
# web app to drop its cached pages (POST /internal/revalidate). Leave both unset
# and pages refresh on their 5-minute timer. Set the same REVALIDATE_SECRET in
# the web app's root .env.local. Production requires at least 32 characters.
# WEB_INTERNAL_URL="http://localhost:5173"
# REVALIDATE_SECRET="dev-revalidate-secret"
