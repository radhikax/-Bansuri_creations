# Optional. By default the storefront and admin call /api on their own origin
# (next.config.ts rewrites it to API_INTERNAL_URL, http://localhost:4000 in dev).
# Set this only to point the frontend at an API on a different origin; admin
# login will not work cross-site.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: instant page refresh. Must match REVALIDATE_SECRET in server/.env;
# the web app rejects POST /internal/revalidate calls that don't carry it.
# REVALIDATE_SECRET=dev-revalidate-secret
